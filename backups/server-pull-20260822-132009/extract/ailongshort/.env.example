# Prisma / 재고관리(WMS) — SQLite
# 스키마가 prisma/schema.prisma 이므로 상대 경로는 prisma 폴더 기준입니다.
# 권장: DATABASE_URL="file:./dev.db"  →  실제 파일 prisma/dev.db
# 비워 두면: 앱이 `file:./dev.db` 를 씁니다 → 실제 파일 `prisma/dev.db` (Prisma 규칙).

# AI 채팅용 API 키 (서버 전용, 클라이언트에 노출되지 않음)
# 복사 후 .env.local 로 저장하고 값만 채우세요.

# ChatGPT (선택: 없으면 AI 대화 패널에서 브라우저에 키 입력 가능)
OPENAI_API_KEY=sk-...

# 재고 WMS (Prisma SQLite / PG) — 수동 지정 시. `file:./prisma/dev.db` 는 잘못된 경로(이중 prisma)입니다.
DATABASE_URL="file:./dev.db"

# Gemini (필수: Gemini / Dual 사용 시). GOOGLE_API_KEY 로 대체 가능
GEMINI_API_KEY=

# 앱·API 접근 로그인 (미설정 시 기본: aichart / longshort)
# 운영에서는 반드시 변경하고 APP_SESSION_SECRET 도 임의 긴 문자열로 설정하세요.
# APP_BRIEFING_LOGIN_USER=aichart
# APP_BRIEFING_LOGIN_PASSWORD=longshort
# APP_SESSION_SECRET=랜덤-긴-문자열
# 운영(NODE_ENV=production)에서는 APP_SESSION_SECRET 필수. 기본값이면 API 503.

# Discord 등 아웃바운드 웹훅 (로그인 쿠키 필요, https만)
# WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=

# 텔레 실시간 알림: 봇 토큰이 있으면 TELEGRAM_SIGNAL_SECRET 필수
# TELEGRAM_SIGNAL_SECRET=

# --- VPS 배포 (예: 167.179.119.140) ---
# npm run start → start.js 가 Next(PORT) + 캔들 서버(SERVER_PORT) 함께 기동
# PORT=3000
# SERVER_PORT=3001
# Next만 띄우려면: npm run start:next-only (캔들 API는 별도 필요)
# 캔들 서버 바인드: 기본 127.0.0.1 (분리 배포 시 CANDLE_SERVER_HOST=0.0.0.0 + CANDLES_SERVER_URL)
# CANDLE_SERVER_HOST=127.0.0.1
# CANDLES_SERVER_URL=http://127.0.0.1:3001
# HTTPS 리버스프록시 뒤면 쿠키 Secure: APP_USE_HTTPS=true
# next dev 에서 IP 접속 시 origin: NEXT_ALLOWED_DEV_ORIGINS=http://167.179.119.140:3000
# Python 엔진 쓰는 경우 (같은 서버): PYTHON_ENGINE_URL=http://127.0.0.1:8000

# --- 앱 안 열어도 서버만으로 텔레 자동 알림 ---
# · 통합텔레(기본 ON): ENTER · E타점/돌파안착 · TP · 무효INV + PNG
# · 게이트: 진입허용·마스터잠금·뉴스창이면 ENTER류 스킵. HQ존터치·1m·후보는 기본 끔
# · data/user-settings.json + 차트설정「텔레그램 발송」
# · 크론(권장 2~3분): bash scripts/telegram-auto-alert-run.sh
#   → /api/cron/telegram-auto-alert + /api/cron/mtf-board-telegram
# TELEGRAM_MULTITF_CRON_SECRET=임의-긴-비밀문자열
# (미설정 시 /api/cron/* 전부 503)
# TELEGRAM_BOT_TOKEN=봇토큰
# TELEGRAM_CHAT_ID=채팅ID
# INTERNAL_API_BASE_URL=http://127.0.0.1:3000
# (선택) /api/analyze 내부호출용. 없으면 크론 시크릿과 동일 값이 x-internal-analyze-secret 로 전달됨
# INTERNAL_ANALYZE_SECRET=
